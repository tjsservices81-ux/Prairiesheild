{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prairiesheildx",
  "compatibility_date": "2026-10-23",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
